		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"if (pm.response.code === 200 && pm.request.url.getPath().endsWith('/api/auth/login')) {",
					"    var data = pm.response.json();",
					"    if (data.data && data.data.token) {",
					"        pm.collectionVariables.set(\"token\", data.data.token);",
					"    }",
					"}"
				]
			}
		}
	],
